rules_version = '2';

// ===============================================================
// Modelo de Dados e Arquitetura de Segurança - SQL Editor Educacional (SENAI)
// ===============================================================
//
// 1. Coleção: users/{userId}
// Document ID: UID do usuário autenticado (request.auth.uid)
// Campos:
//   - uid: string (tamanho até 128) - UID do usuário autenticado (imutável)
//   - email: string (tamanho até 150) - E-mail do usuário
//   - displayName: string (tamanho até 100) - Nome completo ou de exibição
//   - role: string ('admin' | 'professor' | 'aluno') - Papel de acesso
//   - status: string ('active' | 'pending_approval' | 'rejected') - Status de aprovação
//   - course: string (tamanho até 100) - Nome do curso SENAI
//   - turma: string (tamanho até 100) - Código/identificação da turma
//   - courseOrClass: string (tamanho até 150) - Compatibilidade legada
//   - registrationNumber: string (tamanho até 50) - Matrícula acadêmica
//   - phone: string (tamanho até 30) - Telefone/WhatsApp
//   - photoURL: string (tamanho até 1000) - URL do avatar de perfil
//   - classId: string (tamanho até 128) - ID da turma vinculada
//   - className: string (tamanho até 100) - Nome da turma vinculada
//   - classCode: string (tamanho até 10) - Código de acesso de 6 caracteres
//   - classStatus: string ('none' | 'pending' | 'approved' | '') - Situação da matrícula na turma
//   - createdAt: string (tamanho até 50) - Data ISO de criação (imutável)
//   - updatedAt: string (tamanho até 50) - Data ISO da última atualização
//   - emailVerified: bool - Status de confirmação do e-mail
//   - providerId: string (tamanho até 50) - Identificador do provedor de autenticação
//
// 2. Coleção: classes/{classId}
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - name: string (obrigatório, tamanho 1 a 100) - Nome descritivo da turma
//   - course: string (obrigatório, tamanho 1 a 100) - Curso do SENAI associado
//   - code: string (obrigatório, tamanho 4 a 10) - Código alfanumérico único (imutável)
//   - teacherId: string (obrigatório, tamanho 1 a 128) - UID do professor proprietário (imutável)
//   - teacherName: string (obrigatório, tamanho 1 a 100) - Nome completo do professor responsável
//   - teacherEmail: string (obrigatório, tamanho até 150) - E-mail institucional do professor
//   - createdAt: string (obrigatório, tamanho até 50) - Data ISO de criação (imutável)
//   - active: bool (obrigatório) - Indicador se a turma está ativa
//   - studentCount: int (opcional/null, >= 0) - Contador de alunos matriculados na turma
//   - description: string (opcional/null, tamanho até 500) - Observações e plano pedagógico
//   - classroomMode: string (opcional/null, 'normal' | 'classroom' | 'exam') - Modo de operação da sala de aula
//   - chatEnabled: bool (opcional/null) - Habilita ou desabilita o chat para os alunos na turma
//   - scriptSharingEnabled: bool (opcional/null) - Habilita ou desabilita o compartilhamento de scripts entre alunos
//   - activeExamSessionId: string (opcional/null, tamanho até 128) - ID da sessão de avaliação ativa (null ao encerrar)
//   - activeExamSessionLabel: string (opcional/null, tamanho até 120) - Rótulo da sessão de avaliação ativa (null ao encerrar)
//   - activeExamStartedAt: string (tamanho até 50) ou timestamp (opcional/null) - Data/hora de início da sessão de avaliação ativa (null ao encerrar)
//   - examAutoOpenScriptIds: list (opcional/null, máx 50 elementos) - Lista de IDs de scripts de avaliação abertos automaticamente para os alunos
//   - updatedAt: string (tamanho até 50) ou timestamp (opcional/null) - Data/hora da última atualização
//   - id: string (opcional/null, tamanho até 128) - ID do documento da turma
//
// 3. Coleção: class_members/{memberId}
// Document ID: ID no formato `${classId}_${studentUid}`
// Campos:
//   - id: string (opcional, tamanho até 260) - ID do documento de vínculo
//   - classId: string (obrigatório, tamanho 1 a 128) - ID da turma vinculada (imutável)
//   - classCode: string (obrigatório, tamanho 4 a 10) - Código alfanumérico de 6 caracteres da turma
//   - className: string (obrigatório, tamanho 1 a 100) - Nome da turma
//   - studentUid: string (obrigatório, tamanho 1 a 128) - UID do aluno inscrito (imutável)
//   - studentName: string (obrigatório, tamanho 1 a 100) - Nome do aluno inscrito
//   - studentEmail: string (obrigatório, tamanho até 150) - E-mail do aluno inscrito
//   - studentRegistration: string (opcional, tamanho até 50) - Matrícula acadêmica do aluno
//   - status: string (obrigatório, 'pending' | 'approved') - Situação da matrícula do aluno
//   - requestedAt: string (obrigatório, tamanho até 50) - Data ISO do pedido de entrada (imutável)
//   - approvedAt: string (opcional, tamanho até 50) - Data ISO de homologação da entrada pelo docente
//
// 4. Coleção: system_events/{eventId} (Trilha de Auditoria e Conformidade)
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - id: string (opcional, tamanho até 128) - ID do evento no sistema
//   - type: string (obrigatório, enum de tipos de eventos de auditoria)
//   - authorUid: string (obrigatório, tamanho 1 a 128) - UID do usuário que executou a ação (imutável)
//   - authorName: string (obrigatório, tamanho até 100) - Nome do autor da ação
//   - authorEmail: string (obrigatório, tamanho até 150) - E-mail do autor da ação
//   - targetUid: string (opcional, tamanho até 128) - UID do usuário afetado (se aplicável)
//   - targetName: string (opcional, tamanho até 100) - Nome do usuário afetado
//   - targetEmail: string (opcional, tamanho até 150) - E-mail do usuário afetado
//   - details: string (obrigatório, tamanho 1 a 1000) - Descrição minuciosa do evento
//   - timestamp: string (obrigatório, tamanho até 50) - Data e hora ISO do evento (imutável)
//
// 5. Coleção: savedScripts/{scriptId} (Scripts Salvos, Modelos de Banco e Avaliações)
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - title: string (obrigatório, tamanho 1 a 250) - Título do script SQL
//   - description: string (opcional, tamanho até 500) - Descrição detalhada do script
//   - content: string (obrigatório, tamanho 0 a 1000000) - Conteúdo SQL ou DDL (permite conteúdo vazio em abas recém-criadas)
//   - authorUid: string (obrigatório, tamanho 1 a 128) - UID do autor do script (imutável)
//   - authorName: string (obrigatório, tamanho 1 a 100) - Nome do autor da publicação
//   - authorEmail: string (obrigatório, tamanho até 150) - E-mail do autor
//   - authorRole: string (opcional, 'aluno' | 'professor' | 'admin') - Papel acadêmico do autor
//   - category: string (obrigatório, 'student_saved' | 'class_database' | 'example' | 'exercise' | 'solution' | 'exam' | 'exam_submission')
//   - classIds: list (obrigatório, máx 50 elementos) - Turmas associadas ou ['all']
//   - visibleInNormal: bool (opcional) - Visível no Modo Normal junto aos materiais gerais
//   - visibleInClassroom: bool (opcional) - Visível no Modo Sala de Aula
//   - visibleInExam: bool (opcional) - Visível no Modo Avaliação
//   - answerKeySql: string (opcional, tamanho até 1000000) - Gabarito SQL da avaliação para correção automática
//   - grade: number (opcional) - Nota atribuída na correção da entrega de avaliação
//   - teacherFeedback: string (opcional, tamanho até 5000) - Feedback pedagógico do professor
//   - gradedAt: string (opcional, tamanho até 50) - Data ISO da correção
//   - gradedBy: string (opcional, tamanho até 128) - UID do professor que realizou a correção
//   - gradePublished: bool (opcional) - Indica se a nota e feedback estão publicados para o aluno
//   - autoGradeDetails: map (opcional, máx 50 chaves) - Detalhes estruturados da correção automática
//   - isTemporary: bool (opcional) - Indicador de script temporário (backup pré-avaliação)
//   - submittedAt: string (opcional, null ou tamanho até 50) - Data ISO de envio da resolução de avaliação
//   - createdAt: string (obrigatório, tamanho até 50) - Data ISO de criação (imutável)
//   - updatedAt: string (obrigatório, tamanho até 50) - Data ISO da última atualização
//   - id: string (opcional, tamanho até 128) - ID do documento
//
// 6. Coleção: class_presence/{presenceId} (Presença em Tempo Real na Turma)
// Document ID: ID no formato `${classId}_${uid}`
// Campos:
//   - id: string (opcional, tamanho até 260) - ID do registro de presença
//   - classId: string (obrigatório, tamanho 1 a 128) - ID da turma monitorada (imutável)
//   - uid: string (obrigatório, tamanho 1 a 128) - UID do usuário presente (imutável)
//   - displayName: string (opcional, tamanho até 100) - Nome de exibição do usuário
//   - email: string (opcional, tamanho até 150) - E-mail do usuário
//   - role: string (opcional, 'admin' | 'professor' | 'aluno') - Papel do usuário
//   - photoURL: string (opcional, tamanho até 1000) - URL da foto de perfil
//   - isOnline: bool (opcional) - Indicador de conexão ativa
//   - lastSeenAt: string (tamanho até 50) ou timestamp (opcional/null) - Último heartbeat de presença
//   - clientUpdatedAtMs: number (opcional/null, >= 0) - Timestamp em milissegundos no cliente da última atualização de presença
//   - activeView: string (opcional/null, tamanho até 100) - Visão/aba ativa na plataforma
//
// 7. Coleção: class_messages/{messageId} (Chat e Compartilhamento de Scripts da Turma)
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - id: string (opcional, tamanho até 128) - ID da mensagem
//   - classId: string (obrigatório, tamanho 1 a 128) - ID da turma vinculada (imutável)
//   - senderUid: string (obrigatório, tamanho 1 a 128) - UID do remetente (imutável)
//   - senderName: string (opcional, tamanho até 100) - Nome de exibição do remetente
//   - senderRole: string (opcional, 'admin' | 'professor' | 'aluno') - Papel do remetente
//   - senderPhotoURL: string (opcional, tamanho até 1000) - URL do avatar do remetente
//   - recipientUid: string (opcional, tamanho até 128) - 'all' para sala inteira ou UID do destinatário
//   - recipientName: string (opcional, tamanho até 100) - Nome do destinatário (quando privado)
//   - text: string (obrigatório, tamanho até 20000) - Conteúdo textual da mensagem
//   - type: string (opcional, 'text' | 'script') - Tipo da mensagem
//   - scriptTitle: string (opcional, tamanho até 250) - Título do script compartilhado
//   - scriptContent: string (opcional, tamanho até 1000000) - Conteúdo SQL do script compartilhado
//   - createdAt: string (tamanho até 50) ou timestamp (opcional) - Data de envio (imutável)
//   - readBy: list (opcional, máx 1000 elementos) - Lista de UIDs que visualizaram a mensagem
//   - archived: bool (opcional) - Indica se a mensagem foi arquivada pelo professor/admin
//   - archivedAt: string (tamanho até 50) ou timestamp (opcional/null) - Data do arquivamento
//   - archivedBy: string (tamanho até 128, opcional/null) - UID de quem arquivou
//
// 8. Coleção: exam_alerts/{alertId} (Alertas de Monitoramento em Modo Avaliação)
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - id: string (opcional, tamanho até 128) - ID do alerta
//   - classId: string (obrigatório, tamanho 1 a 128) - ID da turma em avaliação (imutável)
//   - studentUid: string (obrigatório, tamanho 1 a 128) - UID do aluno monitorado (imutável)
//   - studentName: string (opcional, tamanho até 100) - Nome do aluno
//   - studentEmail: string (opcional, tamanho até 150) - E-mail do aluno
//   - type: string (opcional, 'tab_switch' | 'window_blur' | 'copy_paste_attempt' | 'extension_detected' | 'devtools_or_resize' | 'page_exit_attempt') - Tipo da ocorrência
//   - details: string (opcional, tamanho até 1000) - Descrição detalhada do evento detectado
//   - examSessionId: string (opcional/null, tamanho até 128) - ID da sessão de avaliação vinculada à ocorrência
//   - examSessionLabel: string (opcional/null, tamanho até 120) - Rótulo da sessão de avaliação vinculada à ocorrência
//   - createdAt: string (tamanho até 50) ou timestamp (opcional) - Data/hora da ocorrência (imutável)
//   - acknowledged: bool (opcional) - Indicador de ciência/confirmação pelo professor
//
// 9. Coleção: student_live_state/{stateId} (Estado ao Vivo do Editor do Aluno)
// Document ID: ID no formato `${classId}_${studentUid}`
// Campos:
//   - id: string (opcional, tamanho até 260) - ID do estado ao vivo
//   - classId: string (obrigatório, tamanho 1 a 128) - ID da turma vinculada (imutável)
//   - studentUid: string (obrigatório, tamanho 1 a 128) - UID do aluno (imutável)
//   - studentName: string (opcional, tamanho até 100) - Nome do aluno
//   - studentEmail: string (opcional, tamanho até 150) - E-mail do aluno
//   - activeTabTitle: string (opcional, tamanho até 250) - Título da aba ativa no editor
//   - activeTabContent: string (opcional, tamanho até 1000000) - Conteúdo SQL da aba ativa
//   - tabs: list (opcional, máx 50 elementos) - Snapshots das abas abertas do aluno
//   - activeDatabase: string (opcional, tamanho até 128) - Banco de dados selecionado pelo aluno
//   - lastQueryStatus: string (opcional, 'success' | 'error') - Status da última execução SQL
//   - lastQueryError: string (opcional, tamanho até 5000) - Última mensagem de erro SQL
//   - lastQuerySummary: string (opcional, tamanho até 2000) - Resumo da última execução SQL
//   - isFrozen: bool (opcional) - Indica se o editor do aluno está congelado pelo docente
//   - frozenMessage: string (opcional, tamanho até 1000) - Mensagem exibida ao aluno durante o bloqueio
//   - violationCount: int (opcional, >= 0) - Contador de ocorrências durante a avaliação
//   - updatedAt: string (tamanho até 50) ou timestamp (opcional) - Data ISO da última atualização
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Funções Utilitárias Globais e RBAC
    // ===============================================================

    // Verifica se a requisição provém de um usuário autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o dono do documento sob a rota
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Administrador Bootstrap garantido para o professor responsável (resiliente a maiúsculas/minúsculas)
    function isBootstrapAdmin() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'williamdevide@gmail.com';
    }

    // Administrador com role 'admin' persistida no Firestore
    function isDocAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Privilégio pleno de Administrador (Bootstrap ou Role de Documento)
    function isAdmin() {
      return isBootstrapAdmin() || isDocAdmin();
    }

    // Verifica se o usuário autenticado é um Professor aprovado e ativo, ou Administrador
    function isTeacherApproved() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'professor' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active'
        )
      );
    }

    // Verifica se o usuário autenticado é o professor proprietário de uma turma específica ou Administrador
    function isClassTeacher(classId) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          classId is string && classId != '' &&
          exists(/databases/$(database)/documents/classes/$(classId)) &&
          get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid
        )
      );
    }

    // Verifica se o usuário autenticado é o professor da turma vinculada ao aluno ou Administrador
    function isTeacherOfUserClass(userDoc) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          'classId' in request.resource.data &&
          request.resource.data.classId is string &&
          request.resource.data.classId != '' &&
          isClassTeacher(request.resource.data.classId)
        ) ||
        (
          'classId' in userDoc.data &&
          userDoc.data.classId is string &&
          userDoc.data.classId != '' &&
          isClassTeacher(userDoc.data.classId)
        )
      );
    }

    // Validação resiliente de e-mail (evita falhas de sintaxe e complexidade de regex no CEL)
    // O Firebase Authentication já valida o formato de e-mail obrigatoriamente antes de qualquer autenticação
    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 150;
    }

    // ===============================================================
    // Validadores de Domínio (Validator Function Pattern)
    // ===============================================================

    // Validador de esquema e limites para a coleção 'users'
    // Resiliente a campos legados e atualizações parciais (sem hasOnly limitante)
    function isValidUser(data) {
      return (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('role' in data) || data.role == null || (data.role is string && (data.role in ['admin', 'professor', 'aluno']))) &&
        (!('status' in data) || data.status == null || (data.status is string && (data.status in ['active', 'pending_approval', 'rejected']))) &&
        (!('course' in data) || data.course == null || (data.course is string && data.course.size() <= 100)) &&
        (!('turma' in data) || data.turma == null || (data.turma is string && data.turma.size() <= 100)) &&
        (!('courseOrClass' in data) || data.courseOrClass == null || (data.courseOrClass is string && data.courseOrClass.size() <= 150)) &&
        (!('registrationNumber' in data) || data.registrationNumber == null || (data.registrationNumber is string && data.registrationNumber.size() <= 50)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('classId' in data) || data.classId == null || (data.classId is string && data.classId.size() <= 128)) &&
        (!('className' in data) || data.className == null || (data.className is string && data.className.size() <= 100)) &&
        (!('classCode' in data) || data.classCode == null || (data.classCode is string && data.classCode.size() <= 10)) &&
        (!('classStatus' in data) || data.classStatus == null || (data.classStatus is string && (data.classStatus in ['none', 'pending', 'approved', '']))) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
        (!('emailVerified' in data) || data.emailVerified == null || data.emailVerified is bool) &&
        (!('providerId' in data) || data.providerId == null || (data.providerId is string && data.providerId.size() <= 50));
    }

    // Validador de esquema e limites para a coleção 'classes'
    function isValidClass(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.course is string && data.course.size() >= 1 && data.course.size() <= 100 &&
        data.code is string && data.code.size() >= 4 && data.code.size() <= 10 &&
        data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100 &&
        data.teacherEmail is string && isValidEmail(data.teacherEmail) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.active is bool &&
        (!('studentCount' in data) || data.studentCount == null || (data.studentCount is int && data.studentCount >= 0)) &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
        (!('classroomMode' in data) || data.classroomMode == null || (data.classroomMode is string && (data.classroomMode in ['normal', 'classroom', 'exam']))) &&
        (!('chatEnabled' in data) || data.chatEnabled == null || data.chatEnabled is bool) &&
        (!('scriptSharingEnabled' in data) || data.scriptSharingEnabled == null || data.scriptSharingEnabled is bool) &&
        (!('activeExamSessionId' in data) || data.activeExamSessionId == null || (data.activeExamSessionId is string && data.activeExamSessionId.size() <= 128)) &&
        (!('activeExamSessionLabel' in data) || data.activeExamSessionLabel == null || (data.activeExamSessionLabel is string && data.activeExamSessionLabel.size() <= 120)) &&
        (!('activeExamStartedAt' in data) || data.activeExamStartedAt == null || (data.activeExamStartedAt is string && data.activeExamStartedAt.size() <= 50) || data.activeExamStartedAt is timestamp) &&
        (!('examAutoOpenScriptIds' in data) || data.examAutoOpenScriptIds == null || (data.examAutoOpenScriptIds is list && data.examAutoOpenScriptIds.size() <= 50)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
        (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128));
    }

    // Validador de esquema e limites para a coleção 'savedScripts'
    function isValidSavedScript(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 250 &&
        data.content is string && data.content.size() <= 1000000 &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.authorEmail is string && data.authorEmail.size() <= 150 &&
        (!('authorRole' in data) || (data.authorRole is string && data.authorRole in ['aluno', 'professor', 'admin'])) &&
        data.category is string && (data.category in ['student_saved', 'class_database', 'example', 'exercise', 'solution', 'exam', 'exam_submission']) &&
        data.classIds is list && data.classIds.size() <= 50 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
        (!('visibleInNormal' in data) || data.visibleInNormal == null || data.visibleInNormal is bool) &&
        (!('visibleInClassroom' in data) || data.visibleInClassroom == null || data.visibleInClassroom is bool) &&
        (!('visibleInExam' in data) || data.visibleInExam == null || data.visibleInExam is bool) &&
        (!('answerKeySql' in data) || data.answerKeySql == null || (data.answerKeySql is string && data.answerKeySql.size() <= 1000000)) &&
        (!('grade' in data) || data.grade == null || data.grade is number) &&
        (!('teacherFeedback' in data) || data.teacherFeedback == null || (data.teacherFeedback is string && data.teacherFeedback.size() <= 5000)) &&
        (!('gradedAt' in data) || data.gradedAt == null || (data.gradedAt is string && data.gradedAt.size() <= 50)) &&
        (!('gradedBy' in data) || data.gradedBy == null || (data.gradedBy is string && data.gradedBy.size() <= 128)) &&
        (!('gradePublished' in data) || data.gradePublished == null || data.gradePublished is bool) &&
        (!('autoGradeDetails' in data) || data.autoGradeDetails == null || (data.autoGradeDetails is map && data.autoGradeDetails.size() <= 50)) &&
        (!('isTemporary' in data) || data.isTemporary == null || data.isTemporary is bool) &&
        (!('submittedAt' in data) || data.submittedAt == null || (data.submittedAt is string && data.submittedAt.size() <= 50)) &&
        (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128));
    }

    // Validador de esquema e limites para a coleção 'class_members'
    function isValidClassMember(data) {
      return data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 &&
        data.classCode is string && data.classCode.size() >= 4 && data.classCode.size() <= 10 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 100 &&
        data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.studentEmail is string && isValidEmail(data.studentEmail) &&
        data.status is string && (data.status in ['pending', 'approved']) &&
        data.requestedAt is string && data.requestedAt.size() <= 50 &&
        (!('studentRegistration' in data) || (data.studentRegistration is string && data.studentRegistration.size() <= 50)) &&
        (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 260));
    }

    // Validador de esquema e limites para a coleção 'system_events'
    function isValidSystemEvent(data) {
      return data.type is string && (data.type in [
          'USER_REGISTERED',
          'PROFESSOR_APPROVED',
          'PROFESSOR_REJECTED',
          'CLASS_CREATED',
          'CLASS_UPDATED',
          'CLASS_DELETED',
          'CLASS_STUDENT_REQUESTED',
          'CLASS_STUDENT_APPROVED',
          'CLASS_STUDENT_REMOVED',
          'ROLE_CHANGED',
          'USER_DELETED'
        ]) &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.authorEmail is string && isValidEmail(data.authorEmail) &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 1000 &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('targetUid' in data) || (data.targetUid is string && data.targetUid.size() <= 128)) &&
        (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 100)) &&
        (!('targetEmail' in data) || (data.targetEmail is string && data.targetEmail.size() <= 150));
    }

    // Validador de esquema e limites para a coleção 'class_presence'
    function isValidClassPresence(data) {
      return data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 260)) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
        (!('role' in data) || data.role == null || (data.role is string && (data.role in ['admin', 'professor', 'aluno']))) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('isOnline' in data) || data.isOnline == null || data.isOnline is bool) &&
        (!('lastSeenAt' in data) || data.lastSeenAt == null || (data.lastSeenAt is string && data.lastSeenAt.size() <= 50) || data.lastSeenAt is timestamp) &&
        (!('clientUpdatedAtMs' in data) || data.clientUpdatedAtMs == null || (data.clientUpdatedAtMs is number && data.clientUpdatedAtMs >= 0)) &&
        (!('activeView' in data) || data.activeView == null || (data.activeView is string && data.activeView.size() <= 100));
    }

    // Validador de esquema e limites para a coleção 'class_messages'
    function isValidClassMessage(data) {
      return data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 &&
        data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
        data.text is string && data.text.size() <= 20000 &&
        (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128)) &&
        (!('senderName' in data) || data.senderName == null || (data.senderName is string && data.senderName.size() <= 100)) &&
        (!('senderRole' in data) || data.senderRole == null || (data.senderRole is string && (data.senderRole in ['admin', 'professor', 'aluno']))) &&
        (!('senderPhotoURL' in data) || data.senderPhotoURL == null || (data.senderPhotoURL is string && data.senderPhotoURL.size() <= 1000)) &&
        (!('recipientUid' in data) || data.recipientUid == null || (data.recipientUid is string && data.recipientUid.size() <= 128)) &&
        (!('recipientName' in data) || data.recipientName == null || (data.recipientName is string && data.recipientName.size() <= 100)) &&
        (!('type' in data) || data.type == null || (data.type is string && (data.type in ['text', 'script']))) &&
        (!('scriptTitle' in data) || data.scriptTitle == null || (data.scriptTitle is string && data.scriptTitle.size() <= 250)) &&
        (!('scriptContent' in data) || data.scriptContent == null || (data.scriptContent is string && data.scriptContent.size() <= 1000000)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
        (!('readBy' in data) || data.readBy == null || (data.readBy is list && data.readBy.size() <= 1000)) &&
        (!('archived' in data) || data.archived == null || data.archived is bool) &&
        (!('archivedAt' in data) || data.archivedAt == null || (data.archivedAt is string && data.archivedAt.size() <= 50) || data.archivedAt is timestamp) &&
        (!('archivedBy' in data) || data.archivedBy == null || (data.archivedBy is string && data.archivedBy.size() <= 128));
    }

    // Validador de esquema e limites para a coleção 'exam_alerts'
    function isValidExamAlert(data) {
      return data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 &&
        data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
        (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128)) &&
        (!('studentName' in data) || data.studentName == null || (data.studentName is string && data.studentName.size() <= 100)) &&
        (!('studentEmail' in data) || data.studentEmail == null || (data.studentEmail is string && data.studentEmail.size() <= 150)) &&
        (!('type' in data) || data.type == null || (data.type is string && (data.type in ['tab_switch', 'window_blur', 'copy_paste_attempt', 'extension_detected', 'devtools_or_resize', 'page_exit_attempt']))) &&
        (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 1000)) &&
        (!('examSessionId' in data) || data.examSessionId == null || (data.examSessionId is string && data.examSessionId.size() <= 128)) &&
        (!('examSessionLabel' in data) || data.examSessionLabel == null || (data.examSessionLabel is string && data.examSessionLabel.size() <= 120)) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
        (!('acknowledged' in data) || data.acknowledged == null || data.acknowledged is bool);
    }

    // Validador de esquema e limites para a coleção 'student_live_state'
    function isValidStudentLiveState(data) {
      return data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 &&
        data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
        (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 260)) &&
        (!('studentName' in data) || data.studentName == null || (data.studentName is string && data.studentName.size() <= 100)) &&
        (!('studentEmail' in data) || data.studentEmail == null || (data.studentEmail is string && data.studentEmail.size() <= 150)) &&
        (!('activeTabTitle' in data) || data.activeTabTitle == null || (data.activeTabTitle is string && data.activeTabTitle.size() <= 250)) &&
        (!('activeTabContent' in data) || data.activeTabContent == null || (data.activeTabContent is string && data.activeTabContent.size() <= 1000000)) &&
        (!('tabs' in data) || data.tabs == null || (data.tabs is list && data.tabs.size() <= 50)) &&
        (!('activeDatabase' in data) || data.activeDatabase == null || (data.activeDatabase is string && data.activeDatabase.size() <= 128)) &&
        (!('lastQueryStatus' in data) || data.lastQueryStatus == null || (data.lastQueryStatus is string && (data.lastQueryStatus in ['success', 'error']))) &&
        (!('lastQueryError' in data) || data.lastQueryError == null || (data.lastQueryError is string && data.lastQueryError.size() <= 5000)) &&
        (!('lastQuerySummary' in data) || data.lastQuerySummary == null || (data.lastQuerySummary is string && data.lastQuerySummary.size() <= 2000)) &&
        (!('isFrozen' in data) || data.isFrozen == null || data.isFrozen is bool) &&
        (!('frozenMessage' in data) || data.frozenMessage == null || (data.frozenMessage is string && data.frozenMessage.size() <= 1000)) &&
        (!('violationCount' in data) || data.violationCount == null || (data.violationCount is int && data.violationCount >= 0)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp);
    }

    // ===============================================================
    // Coleção: users/{userId}
    // ===============================================================
    match /users/{userId} {
      // Leitura individual: o próprio usuário, professores autorizados ou Administradores
      allow get: if isAuthenticated() && (isOwner(userId) || isTeacherApproved() || isAdmin());

      // Listagem de usuários: Administradores e Professores autorizados
      // (Professores validam a existência do aluno por e-mail para admissão direta)
      // Bloqueia enumeração geral e vazamento de PII por alunos comuns
      allow list: if isAuthenticated() && (isTeacherApproved() || isAdmin());

      // Criação de perfil no auto-cadastro ou aprovação:
      // a) Aluno: role 'aluno' e status 'active'
      // b) Professor: role 'professor' e status 'pending_approval' (aguardando autorização)
      // c) Administrador (incluindo Bootstrap Admin): permissão para criar qualquer perfil
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.get('uid', userId) == userId &&
          isValidUser(request.resource.data) &&
          (
            (request.resource.data.get('role', 'aluno') == 'aluno' && request.resource.data.get('status', 'active') == 'active') ||
            (request.resource.data.get('role', '') == 'professor' && request.resource.data.get('status', 'pending_approval') == 'pending_approval') ||
            (isBootstrapAdmin() && request.resource.data.get('role', '') == 'admin' && request.resource.data.get('status', 'active') == 'active')
          )
        )
      );

      // Atualização de perfil:
      // - Administrador pode atualizar qualquer perfil (aprovar/rejeitar docente ou alterar papéis)
      // - O próprio usuário pode atualizar seus dados cadastrais e solicitar entrada em turma (classStatus: 'pending' ou 'none')
      //   (é estritamente proibida auto-elevação para 'admin' ou auto-aprovação de status 'active' para docente)
      // - O professor da turma pode atualizar os campos de turma do aluno ao admitir, aprovar ou remover
      allow update: if isAuthenticated() && (
        // 1. Administrador pleno (pode alterar qualquer campo, aprovar/rejeitar professores, etc.)
        isAdmin() ||
        // 2. O próprio usuário atualizando seus dados de perfil cadastrais
        (
          isOwner(userId) &&
          isValidUser(request.resource.data) &&
          // Não permite auto-elevação para 'admin'
          (request.resource.data.get('role', resource.data.get('role', 'aluno')) != 'admin' || resource.data.get('role', '') == 'admin') &&
          // Não permite auto-aprovação de status 'active' para docente
          (
            resource.data.get('role', '') != 'professor' ||
            resource.data.get('status', 'pending_approval') == 'active' ||
            request.resource.data.get('status', 'pending_approval') != 'active'
          ) &&
          // UID imutável e estritamente correspondente ao ID da rota
          (!('uid' in resource.data) || resource.data.uid == null || resource.data.uid == '' || request.resource.data.get('uid', '') == resource.data.get('uid', '')) &&
          request.resource.data.get('uid', userId) == userId &&
          // Data de criação imutável quando previamente gravada
          (!('createdAt' in resource.data) || resource.data.createdAt == null || resource.data.createdAt == '' || request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')) &&
          // Status de turma: aluno pode manter ou solicitar pendente ('none' ou 'pending')
          (
            request.resource.data.get('classStatus', 'none') == resource.data.get('classStatus', 'none') ||
            request.resource.data.get('classStatus', 'none') in ['none', 'pending']
          )
        ) ||
        // 3. Professor da turma atualizando campos de turma do aluno ao admitir, aprovar ou remover
        (
          isTeacherOfUserClass(resource) &&
          isValidUser(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId', 'className', 'classCode', 'classStatus', 'turma', 'updatedAt']) &&
          request.resource.data.get('role', 'aluno') == resource.data.get('role', 'aluno') &&
          request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        )
      );

      // Exclusão de perfil: estritamente restrita ao Administrador (proteção contra auto-exclusão e perda de histórico)
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Coleção: classes/{classId}
    // ===============================================================
    match /classes/{classId} {
      // Leitura: qualquer usuário autenticado pode ler turmas ativas
      // (necessário para validação de código de acesso de 6 caracteres e listagens pedagógicas)
      allow get, list: if isAuthenticated();

      // Criação: exclusivamente professores aprovados ou Administradores
      // O professor logado deve ser registrado como dono da turma (teacherId == request.auth.uid)
      allow create: if isAuthenticated() &&
                       (isTeacherApproved() || isAdmin()) &&
                       isValidClass(request.resource.data) &&
                       (request.resource.data.teacherId == request.auth.uid || isAdmin());

      // Atualização: o professor proprietário da turma ou Administrador
      // Campos imutáveis para integridade: teacherId, code e createdAt
      allow update: if isAuthenticated() &&
                       isValidClass(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           resource.data.teacherId == request.auth.uid &&
                           request.resource.data.teacherId == resource.data.teacherId &&
                           request.resource.data.code == resource.data.code &&
                           request.resource.data.createdAt == resource.data.createdAt
                         )
                       );

      // Exclusão: o professor proprietário da turma ou Administrador
      allow delete: if isAuthenticated() &&
                       (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // Coleção: class_members/{memberId}
    // ===============================================================
    match /class_members/{memberId} {
      // Leitura individual e listagem de vínculos de turma
      // Permite consultas seguras para alunos, professores e administradores
      allow get, list: if isAuthenticated();

      // Criação de matrícula / solicitação:
      // a) O próprio aluno solicitando entrada com status 'pending' (a turma deve existir)
      // b) O professor dono da turma admitindo o aluno diretamente com status 'approved'
      // c) Administrador
      allow create: if isAuthenticated() &&
                       isValidClassMember(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           request.resource.data.studentUid == request.auth.uid &&
                           request.resource.data.status == 'pending' &&
                           exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
                         ) ||
                         (
                           isClassTeacher(request.resource.data.classId) &&
                           request.resource.data.status == 'approved'
                         )
                       );

      // Atualização: o professor dono da turma aprovando solicitação (status -> 'approved') ou Administrador
      // Campos imutáveis: classId, studentUid e requestedAt
      allow update: if isAuthenticated() &&
                       isValidClassMember(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           isClassTeacher(resource.data.classId) &&
                           request.resource.data.classId == resource.data.classId &&
                           request.resource.data.studentUid == resource.data.studentUid &&
                           request.resource.data.requestedAt == resource.data.requestedAt &&
                           request.resource.data.status == 'approved'
                         )
                       );

      // Exclusão: o professor dono da turma, o próprio aluno cancelando solicitação ou Administrador
      allow delete: if isAuthenticated() &&
                       (
                         isAdmin() ||
                         isClassTeacher(resource.data.classId) ||
                         resource.data.studentUid == request.auth.uid
                       );
    }

    // ===============================================================
    // Coleção: system_events/{eventId} (Trilha de Auditoria)
    // ===============================================================
    match /system_events/{eventId} {
      // Leitura: exclusivo para Administradores (Painel de Auditoria e exportação CSV/JSON)
      allow get, list: if isAdmin();

      // Criação: qualquer usuário autenticado registrando um evento executado por ele mesmo (ou Administrador)
      // O authorUid deve corresponder com rigor ao UID do usuário logado (evita spoofing de autor)
      allow create: if isAuthenticated() &&
                       (request.resource.data.authorUid == request.auth.uid || isAdmin()) &&
                       isValidSystemEvent(request.resource.data);

      // Atualização e Exclusão: estritamente proibidos para garantir integridade e não-repúdio do log
      allow update, delete: if false;
    }

    // ===============================================================
    // Coleção: savedScripts/{scriptId} (Scripts Salvos, BDs de Aula e Avaliações)
    // ===============================================================
    match /savedScripts/{scriptId} {
      // Leitura: usuário autenticado (acesso completo às consultas) ou visitante não autenticado
      // exclusivamente para itens do catálogo público do Modo Normal ('normal_global' em classIds)
      allow get, list: if isAuthenticated() ||
                          (
                            resource.data.classIds is list &&
                            'normal_global' in resource.data.classIds
                          );

      // Criação: usuário autenticado criando seu próprio script, professor aprovado ou Administrador
      // Somente Administradores podem incluir 'normal_global' em classIds (catálogo público)
      allow create: if isAuthenticated() &&
                       isValidSavedScript(request.resource.data) &&
                       (request.resource.data.authorUid == request.auth.uid || isAdmin() || isTeacherApproved()) &&
                       (!('normal_global' in request.resource.data.classIds) || isAdmin());

      // Atualização: o próprio autor do script, o professor da turma (correção de entregas de avaliação) ou Administrador
      // authorUid e createdAt são estritamente imutáveis para integridade do registro
      // Somente Administradores podem incluir, manter ou alterar scripts com 'normal_global' em classIds
      allow update: if isAuthenticated() &&
                       isValidSavedScript(request.resource.data) &&
                       request.resource.data.authorUid == resource.data.authorUid &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         (
                           !('normal_global' in request.resource.data.classIds) &&
                           !('classIds' in resource.data && resource.data.classIds is list && 'normal_global' in resource.data.classIds)
                         ) ||
                         isAdmin()
                       ) &&
                       (
                         resource.data.authorUid == request.auth.uid ||
                         isAdmin() ||
                         (
                           isTeacherApproved() &&
                           resource.data.category == 'exam_submission' &&
                           resource.data.classIds is list &&
                           resource.data.classIds.size() > 0 &&
                           isClassTeacher(resource.data.classIds[0])
                         )
                       );

      // Exclusão: o próprio autor do script ou Administrador
      allow delete: if isAuthenticated() &&
                       (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // Coleção: class_presence/{presenceId} (Presença em Tempo Real na Turma)
    // ===============================================================
    match /class_presence/{presenceId} {
      // Leitura: qualquer usuário autenticado (lista de presença em tempo real da turma)
      allow get, list: if isAuthenticated();

      // Criação: o próprio usuário registrando sua presença ou Administrador
      allow create: if isAuthenticated() &&
                       isValidClassPresence(request.resource.data) &&
                       (request.resource.data.uid == request.auth.uid || isAdmin());

      // Atualização: o próprio usuário atualizando seu status online/heartbeat ou Administrador
      // uid e classId permanecem imutáveis para não-administradores
      allow update: if isAuthenticated() &&
                       isValidClassPresence(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           resource.data.uid == request.auth.uid &&
                           request.resource.data.uid == resource.data.uid &&
                           request.resource.data.classId == resource.data.classId
                         )
                       );

      // Exclusão: o próprio usuário ou Administrador
      allow delete: if isAuthenticated() &&
                       (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // Coleção: class_messages/{messageId} (Chat e Compartilhamento de Scripts)
    // ===============================================================
    match /class_messages/{messageId} {
      // Leitura: qualquer usuário autenticado (mensagens e scripts compartilhados na turma)
      allow get, list: if isAuthenticated();

      // Criação: o próprio remetente autenticado ou Administrador
      // Remetentes não docentes/não administradores não podem pré-arquivar mensagens ou forjar metadados de arquivamento na criação
      allow create: if isAuthenticated() &&
                       isValidClassMessage(request.resource.data) &&
                       (request.resource.data.senderUid == request.auth.uid || isAdmin()) &&
                       (
                         (
                           (!('archived' in request.resource.data) || request.resource.data.archived == null || request.resource.data.archived == false) &&
                           (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt == null) &&
                           (!('archivedBy' in request.resource.data) || request.resource.data.archivedBy == null)
                         ) ||
                         isAdmin() ||
                         isClassTeacher(request.resource.data.classId)
                       );

      // Atualização:
      // - Administrador (acesso total, sujeito ao validador de esquema)
      // - Professor da turma (pode arquivar/desarquivar e editar mantendo senderUid, classId e createdAt imutáveis, sem forjar archivedBy de terceiros)
      // - Remetente original (mantendo senderUid, classId e createdAt imutáveis, proibido de alterar archived/archivedAt/archivedBy)
      // - Confirmação de leitura (readBy) pelo destinatário ou em mensagens coletivas ('all')
      allow update: if isAuthenticated() &&
                       isValidClassMessage(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           isClassTeacher(resource.data.classId) &&
                           request.resource.data.senderUid == resource.data.senderUid &&
                           request.resource.data.classId == resource.data.classId &&
                           (!('createdAt' in resource.data) || resource.data.createdAt == null || request.resource.data.createdAt == resource.data.createdAt) &&
                           (
                             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archivedBy']) ||
                             !('archivedBy' in request.resource.data) ||
                             request.resource.data.archivedBy == null ||
                             request.resource.data.archivedBy == request.auth.uid
                           )
                         ) ||
                         (
                           resource.data.senderUid == request.auth.uid &&
                           request.resource.data.senderUid == resource.data.senderUid &&
                           request.resource.data.classId == resource.data.classId &&
                           (!('createdAt' in resource.data) || resource.data.createdAt == null || request.resource.data.createdAt == resource.data.createdAt) &&
                           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived', 'archivedAt', 'archivedBy'])
                         ) ||
                         (
                           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
                           (resource.data.get('recipientUid', 'all') in ['all', '', null] || resource.data.recipientUid == request.auth.uid)
                         )
                       );

      // Exclusão: Administrador, professor da turma ou o próprio remetente
      allow delete: if isAuthenticated() &&
                       (isAdmin() || isClassTeacher(resource.data.classId) || resource.data.senderUid == request.auth.uid);
    }

    // ===============================================================
    // Coleção: exam_alerts/{alertId} (Alertas de Monitoramento de Avaliação)
    // ===============================================================
    match /exam_alerts/{alertId} {
      // Leitura: qualquer usuário autenticado (monitoramento da avaliação e registro do aluno)
      allow get, list: if isAuthenticated();

      // Criação: o próprio aluno reportando ocorrência de monitoramento ou Administrador
      allow create: if isAuthenticated() &&
                       isValidExamAlert(request.resource.data) &&
                       (request.resource.data.studentUid == request.auth.uid || isAdmin());

      // Atualização: exclusivamente Administrador ou professor da turma (ex: reconhecer alerta)
      allow update: if isAuthenticated() &&
                       isValidExamAlert(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           isClassTeacher(resource.data.classId) &&
                           request.resource.data.studentUid == resource.data.studentUid &&
                           request.resource.data.classId == resource.data.classId &&
                           (!('createdAt' in resource.data) || resource.data.createdAt == null || request.resource.data.createdAt == resource.data.createdAt)
                         )
                       );

      // Exclusão: exclusivamente Administrador ou professor da turma
      allow delete: if isAuthenticated() &&
                       (isAdmin() || isClassTeacher(resource.data.classId));
    }

    // ===============================================================
    // Coleção: student_live_state/{stateId} (Estado ao Vivo do Editor do Aluno)
    // ===============================================================
    match /student_live_state/{stateId} {
      // Leitura: qualquer usuário autenticado (acompanhamento em tempo real em sala/avaliação)
      allow get, list: if isAuthenticated();

      // Criação: o próprio aluno inicializando seu estado ao vivo ou Administrador
      allow create: if isAuthenticated() &&
                       isValidStudentLiveState(request.resource.data) &&
                       (request.resource.data.studentUid == request.auth.uid || isAdmin());

      // Atualização: Administrador, professor da turma (congelar/descongelar editor) ou próprio aluno
      // studentUid e classId permanecem imutáveis para não-administradores
      allow update: if isAuthenticated() &&
                       isValidStudentLiveState(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           (resource.data.studentUid == request.auth.uid || isClassTeacher(resource.data.classId)) &&
                           request.resource.data.studentUid == resource.data.studentUid &&
                           request.resource.data.classId == resource.data.classId
                         )
                       );

      // Exclusão: exclusivamente Administrador ou professor da turma
      allow delete: if isAuthenticated() &&
                       (isAdmin() || isClassTeacher(resource.data.classId));
    }

    // ===============================================================
    // Bloqueio Padrão (Default Deny)
    // ===============================================================
    // Bloqueia qualquer leitura ou gravação em coleções ou rotas não mapeadas explicitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
