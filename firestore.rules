rules_version = '2';

// ===============================================================
// Modelo de Dados e Arquitetura de Segurança - SQL Editor Educacional (SENAI)
// ===============================================================
//
// 1. Coleção: users/{userId}
// Document ID: UID do usuário autenticado (request.auth.uid)
// Campos:
//   - uid: string (tamanho até 128) - UID do usuário autenticado (imutável)
//   - email: string (tamanho até 150) - E-mail do usuário
//   - displayName: string (tamanho até 100) - Nome completo ou de exibição
//   - role: string ('admin' | 'professor' | 'aluno') - Papel de acesso
//   - status: string ('active' | 'pending_approval' | 'rejected') - Status de aprovação
//   - course: string (tamanho até 100) - Nome do curso SENAI
//   - turma: string (tamanho até 100) - Código/identificação da turma
//   - courseOrClass: string (tamanho até 150) - Compatibilidade legada
//   - registrationNumber: string (tamanho até 50) - Matrícula acadêmica
//   - phone: string (tamanho até 30) - Telefone/WhatsApp
//   - photoURL: string (tamanho até 1000) - URL do avatar de perfil
//   - classId: string (tamanho até 128) - ID da turma vinculada
//   - className: string (tamanho até 100) - Nome da turma vinculada
//   - classCode: string (tamanho até 10) - Código de acesso de 6 caracteres
//   - classStatus: string ('none' | 'pending' | 'approved' | '') - Situação da matrícula na turma
//   - createdAt: string (tamanho até 50) - Data ISO de criação (imutável)
//   - updatedAt: string (tamanho até 50) - Data ISO da última atualização
//   - emailVerified: bool - Status de confirmação do e-mail
//   - providerId: string (tamanho até 50) - Identificador do provedor de autenticação
//
// 2. Coleção: classes/{classId}
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - name: string (obrigatório, tamanho 1 a 100) - Nome descritivo da turma
//   - course: string (obrigatório, tamanho 1 a 100) - Curso do SENAI associado
//   - code: string (obrigatório, tamanho 4 a 10) - Código alfanumérico único (imutável)
//   - teacherId: string (obrigatório, tamanho 1 a 128) - UID do professor proprietário (imutável)
//   - teacherName: string (obrigatório, tamanho 1 a 100) - Nome completo do professor responsável
//   - teacherEmail: string (obrigatório, tamanho até 150) - E-mail institucional do professor
//   - createdAt: string (obrigatório, tamanho até 50) - Data ISO de criação (imutável)
//   - active: bool (obrigatório) - Indicador se a turma está ativa
//   - studentCount: int (opcional, >= 0) - Contador de alunos matriculados na turma
//   - description: string (opcional, tamanho até 500) - Observações e plano pedagógico
//
// 3. Coleção: class_members/{memberId}
// Document ID: ID no formato `${classId}_${studentUid}`
// Campos:
//   - id: string (opcional, tamanho até 260) - ID do documento de vínculo
//   - classId: string (obrigatório, tamanho 1 a 128) - ID da turma vinculada (imutável)
//   - classCode: string (obrigatório, tamanho 4 a 10) - Código alfanumérico de 6 caracteres da turma
//   - className: string (obrigatório, tamanho 1 a 100) - Nome da turma
//   - studentUid: string (obrigatório, tamanho 1 a 128) - UID do aluno inscrito (imutável)
//   - studentName: string (obrigatório, tamanho 1 a 100) - Nome do aluno inscrito
//   - studentEmail: string (obrigatório, tamanho até 150) - E-mail do aluno inscrito
//   - studentRegistration: string (opcional, tamanho até 50) - Matrícula acadêmica do aluno
//   - status: string (obrigatório, 'pending' | 'approved') - Situação da matrícula do aluno
//   - requestedAt: string (obrigatório, tamanho até 50) - Data ISO do pedido de entrada (imutável)
//   - approvedAt: string (opcional, tamanho até 50) - Data ISO de homologação da entrada pelo docente
//
// 4. Coleção: system_events/{eventId} (Trilha de Auditoria e Conformidade)
// Document ID: ID único gerado automaticamente pelo Firestore
// Campos:
//   - id: string (opcional, tamanho até 128) - ID do evento no sistema
//   - type: string (obrigatório, enum de tipos de eventos de auditoria)
//   - authorUid: string (obrigatório, tamanho 1 a 128) - UID do usuário que executou a ação (imutável)
//   - authorName: string (obrigatório, tamanho até 100) - Nome do autor da ação
//   - authorEmail: string (obrigatório, tamanho até 150) - E-mail do autor da ação
//   - targetUid: string (opcional, tamanho até 128) - UID do usuário afetado (se aplicável)
//   - targetName: string (opcional, tamanho até 100) - Nome do usuário afetado
//   - targetEmail: string (opcional, tamanho até 150) - E-mail do usuário afetado
//   - details: string (obrigatório, tamanho 1 a 1000) - Descrição minuciosa do evento
//   - timestamp: string (obrigatório, tamanho até 50) - Data e hora ISO do evento (imutável)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Funções Utilitárias Globais e RBAC
    // ===============================================================

    // Verifica se a requisição provém de um usuário autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário autenticado é o dono do documento sob a rota
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Administrador Bootstrap garantido para o professor responsável (resiliente a maiúsculas/minúsculas)
    function isBootstrapAdmin() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'williamdevide@gmail.com';
    }

    // Administrador com role 'admin' persistida no Firestore
    function isDocAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Privilégio pleno de Administrador (Bootstrap ou Role de Documento)
    function isAdmin() {
      return isBootstrapAdmin() || isDocAdmin();
    }

    // Verifica se o usuário autenticado é um Professor aprovado e ativo, ou Administrador
    function isTeacherApproved() {
      return isAuthenticated() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'professor' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') == 'active'
        )
      );
    }

    // Verifica se o usuário autenticado é o professor proprietário de uma turma específica ou Administrador
    function isClassTeacher(classId) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          classId is string && classId != '' &&
          exists(/databases/$(database)/documents/classes/$(classId)) &&
          get(/databases/$(database)/documents/classes/$(classId)).data.get('teacherId', '') == request.auth.uid
        )
      );
    }

    // Verifica se o usuário autenticado é o professor da turma vinculada ao aluno ou Administrador
    function isTeacherOfUserClass(userDoc) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          'classId' in request.resource.data &&
          request.resource.data.classId is string &&
          request.resource.data.classId != '' &&
          isClassTeacher(request.resource.data.classId)
        ) ||
        (
          'classId' in userDoc.data &&
          userDoc.data.classId is string &&
          userDoc.data.classId != '' &&
          isClassTeacher(userDoc.data.classId)
        )
      );
    }

    // Validação resiliente de e-mail (evita falhas de sintaxe e complexidade de regex no CEL)
    // O Firebase Authentication já valida o formato de e-mail obrigatoriamente antes de qualquer autenticação
    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 150;
    }

    // ===============================================================
    // Validadores de Domínio (Validator Function Pattern)
    // ===============================================================

    // Validador de esquema e limites para a coleção 'users'
    // Resiliente a campos legados e atualizações parciais (sem hasOnly limitante)
    function isValidUser(data) {
      return (!('uid' in data) || data.uid == null || (data.uid is string && data.uid.size() <= 128)) &&
        (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
        (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('role' in data) || data.role == null || (data.role is string && (data.role in ['admin', 'professor', 'aluno']))) &&
        (!('status' in data) || data.status == null || (data.status is string && (data.status in ['active', 'pending_approval', 'rejected']))) &&
        (!('course' in data) || data.course == null || (data.course is string && data.course.size() <= 100)) &&
        (!('turma' in data) || data.turma == null || (data.turma is string && data.turma.size() <= 100)) &&
        (!('courseOrClass' in data) || data.courseOrClass == null || (data.courseOrClass is string && data.courseOrClass.size() <= 150)) &&
        (!('registrationNumber' in data) || data.registrationNumber == null || (data.registrationNumber is string && data.registrationNumber.size() <= 50)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 30)) &&
        (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('classId' in data) || data.classId == null || (data.classId is string && data.classId.size() <= 128)) &&
        (!('className' in data) || data.className == null || (data.className is string && data.className.size() <= 100)) &&
        (!('classCode' in data) || data.classCode == null || (data.classCode is string && data.classCode.size() <= 10)) &&
        (!('classStatus' in data) || data.classStatus == null || (data.classStatus is string && (data.classStatus in ['none', 'pending', 'approved', '']))) &&
        (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50)) &&
        (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
        (!('emailVerified' in data) || data.emailVerified == null || data.emailVerified is bool) &&
        (!('providerId' in data) || data.providerId == null || (data.providerId is string && data.providerId.size() <= 50));
    }

    // Validador de esquema e limites para a coleção 'classes'
    function isValidClass(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.course is string && data.course.size() >= 1 && data.course.size() <= 100 &&
        data.code is string && data.code.size() >= 4 && data.code.size() <= 10 &&
        data.teacherId is string && data.teacherId.size() >= 1 && data.teacherId.size() <= 128 &&
        data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100 &&
        data.teacherEmail is string && isValidEmail(data.teacherEmail) &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.active is bool &&
        (!('studentCount' in data) || (data.studentCount is int && data.studentCount >= 0)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // Validador de esquema e limites para a coleção 'class_members'
    function isValidClassMember(data) {
      return data.classId is string && data.classId.size() >= 1 && data.classId.size() <= 128 &&
        data.classCode is string && data.classCode.size() >= 4 && data.classCode.size() <= 10 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 100 &&
        data.studentUid is string && data.studentUid.size() >= 1 && data.studentUid.size() <= 128 &&
        data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
        data.studentEmail is string && isValidEmail(data.studentEmail) &&
        data.status is string && (data.status in ['pending', 'approved']) &&
        data.requestedAt is string && data.requestedAt.size() <= 50 &&
        (!('studentRegistration' in data) || (data.studentRegistration is string && data.studentRegistration.size() <= 50)) &&
        (!('approvedAt' in data) || (data.approvedAt is string && data.approvedAt.size() <= 50)) &&
        (!('id' in data) || (data.id is string && data.id.size() <= 260));
    }

    // Validador de esquema e limites para a coleção 'system_events'
    function isValidSystemEvent(data) {
      return data.type is string && (data.type in [
          'USER_REGISTERED',
          'PROFESSOR_APPROVED',
          'PROFESSOR_REJECTED',
          'CLASS_CREATED',
          'CLASS_STUDENT_REQUESTED',
          'CLASS_STUDENT_APPROVED',
          'CLASS_STUDENT_REMOVED',
          'ROLE_CHANGED',
          'USER_DELETED'
        ]) &&
        data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.authorEmail is string && isValidEmail(data.authorEmail) &&
        data.details is string && data.details.size() >= 1 && data.details.size() <= 1000 &&
        data.timestamp is string && data.timestamp.size() <= 50 &&
        (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
        (!('targetUid' in data) || (data.targetUid is string && data.targetUid.size() <= 128)) &&
        (!('targetName' in data) || (data.targetName is string && data.targetName.size() <= 100)) &&
        (!('targetEmail' in data) || (data.targetEmail is string && data.targetEmail.size() <= 150));
    }

    // ===============================================================
    // Coleção: users/{userId}
    // ===============================================================
    match /users/{userId} {
      // Leitura individual: o próprio usuário, professores autorizados ou Administradores
      allow get: if isAuthenticated() && (isOwner(userId) || isTeacherApproved() || isAdmin());

      // Listagem de usuários: Administradores e Professores autorizados
      // (Professores validam a existência do aluno por e-mail para admissão direta)
      // Bloqueia enumeração geral e vazamento de PII por alunos comuns
      allow list: if isAuthenticated() && (isTeacherApproved() || isAdmin());

      // Criação de perfil no auto-cadastro ou aprovação:
      // a) Aluno: role 'aluno' e status 'active'
      // b) Professor: role 'professor' e status 'pending_approval' (aguardando autorização)
      // c) Administrador (incluindo Bootstrap Admin): permissão para criar qualquer perfil
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          isOwner(userId) &&
          request.resource.data.get('uid', userId) == userId &&
          isValidUser(request.resource.data) &&
          (
            (request.resource.data.get('role', 'aluno') == 'aluno' && request.resource.data.get('status', 'active') == 'active') ||
            (request.resource.data.get('role', '') == 'professor' && request.resource.data.get('status', 'pending_approval') == 'pending_approval') ||
            (isBootstrapAdmin() && request.resource.data.get('role', '') == 'admin' && request.resource.data.get('status', 'active') == 'active')
          )
        )
      );

      // Atualização de perfil:
      // - Administrador pode atualizar qualquer perfil (aprovar/rejeitar docente ou alterar papéis)
      // - O próprio usuário pode atualizar seus dados cadastrais e solicitar entrada em turma (classStatus: 'pending' ou 'none')
      //   (é estritamente proibida auto-elevação para 'admin' ou auto-aprovação de status 'active' para docente)
      // - O professor da turma pode atualizar os campos de turma do aluno ao admitir, aprovar ou remover
      allow update: if isAuthenticated() && (
        // 1. Administrador pleno (pode alterar qualquer campo, aprovar/rejeitar professores, etc.)
        isAdmin() ||
        // 2. O próprio usuário atualizando seus dados de perfil cadastrais
        (
          isOwner(userId) &&
          isValidUser(request.resource.data) &&
          // Não permite auto-elevação para 'admin'
          (request.resource.data.get('role', resource.data.get('role', 'aluno')) != 'admin' || resource.data.get('role', '') == 'admin') &&
          // Não permite auto-aprovação de status 'active' para docente
          (
            resource.data.get('role', '') != 'professor' ||
            resource.data.get('status', 'pending_approval') == 'active' ||
            request.resource.data.get('status', 'pending_approval') != 'active'
          ) &&
          // UID imutável e estritamente correspondente ao ID da rota
          (!('uid' in resource.data) || resource.data.uid == null || resource.data.uid == '' || request.resource.data.get('uid', '') == resource.data.get('uid', '')) &&
          request.resource.data.get('uid', userId) == userId &&
          // Data de criação imutável quando previamente gravada
          (!('createdAt' in resource.data) || resource.data.createdAt == null || resource.data.createdAt == '' || request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')) &&
          // Status de turma: aluno pode manter ou solicitar pendente ('none' ou 'pending')
          (
            request.resource.data.get('classStatus', 'none') == resource.data.get('classStatus', 'none') ||
            request.resource.data.get('classStatus', 'none') in ['none', 'pending']
          )
        ) ||
        // 3. Professor da turma atualizando campos de turma do aluno ao admitir, aprovar ou remover
        (
          isTeacherOfUserClass(resource) &&
          isValidUser(request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['classId', 'className', 'classCode', 'classStatus', 'turma', 'updatedAt']) &&
          request.resource.data.get('role', 'aluno') == resource.data.get('role', 'aluno') &&
          request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
        )
      );

      // Exclusão de perfil: estritamente restrita ao Administrador (proteção contra auto-exclusão e perda de histórico)
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Coleção: classes/{classId}
    // ===============================================================
    match /classes/{classId} {
      // Leitura: qualquer usuário autenticado pode ler turmas ativas
      // (necessário para validação de código de acesso de 6 caracteres e listagens pedagógicas)
      allow get, list: if isAuthenticated();

      // Criação: exclusivamente professores aprovados ou Administradores
      // O professor logado deve ser registrado como dono da turma (teacherId == request.auth.uid)
      allow create: if isAuthenticated() &&
                       (isTeacherApproved() || isAdmin()) &&
                       isValidClass(request.resource.data) &&
                       (request.resource.data.teacherId == request.auth.uid || isAdmin());

      // Atualização: o professor proprietário da turma ou Administrador
      // Campos imutáveis para integridade: teacherId, code e createdAt
      allow update: if isAuthenticated() &&
                       isValidClass(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           resource.data.teacherId == request.auth.uid &&
                           request.resource.data.teacherId == resource.data.teacherId &&
                           request.resource.data.code == resource.data.code &&
                           request.resource.data.createdAt == resource.data.createdAt
                         )
                       );

      // Exclusão: o professor proprietário da turma ou Administrador
      allow delete: if isAuthenticated() &&
                       (resource.data.teacherId == request.auth.uid || isAdmin());
    }

    // ===============================================================
    // Coleção: class_members/{memberId}
    // ===============================================================
    match /class_members/{memberId} {
      // Leitura individual e listagem de vínculos de turma
      // Permite consultas seguras para alunos, professores e administradores
      allow get, list: if isAuthenticated();

      // Criação de matrícula / solicitação:
      // a) O próprio aluno solicitando entrada com status 'pending' (a turma deve existir)
      // b) O professor dono da turma admitindo o aluno diretamente com status 'approved'
      // c) Administrador
      allow create: if isAuthenticated() &&
                       isValidClassMember(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           request.resource.data.studentUid == request.auth.uid &&
                           request.resource.data.status == 'pending' &&
                           exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
                         ) ||
                         (
                           isClassTeacher(request.resource.data.classId) &&
                           request.resource.data.status == 'approved'
                         )
                       );

      // Atualização: o professor dono da turma aprovando solicitação (status -> 'approved') ou Administrador
      // Campos imutáveis: classId, studentUid e requestedAt
      allow update: if isAuthenticated() &&
                       isValidClassMember(request.resource.data) &&
                       (
                         isAdmin() ||
                         (
                           isClassTeacher(resource.data.classId) &&
                           request.resource.data.classId == resource.data.classId &&
                           request.resource.data.studentUid == resource.data.studentUid &&
                           request.resource.data.requestedAt == resource.data.requestedAt &&
                           request.resource.data.status == 'approved'
                         )
                       );

      // Exclusão: o professor dono da turma, o próprio aluno cancelando solicitação ou Administrador
      allow delete: if isAuthenticated() &&
                       (
                         isAdmin() ||
                         isClassTeacher(resource.data.classId) ||
                         resource.data.studentUid == request.auth.uid
                       );
    }

    // ===============================================================
    // Coleção: system_events/{eventId} (Trilha de Auditoria)
    // ===============================================================
    match /system_events/{eventId} {
      // Leitura: exclusivo para Administradores (Painel de Auditoria e exportação CSV/JSON)
      allow get, list: if isAdmin();

      // Criação: qualquer usuário autenticado registrando um evento executado por ele mesmo (ou Administrador)
      // O authorUid deve corresponder com rigor ao UID do usuário logado (evita spoofing de autor)
      allow create: if isAuthenticated() &&
                       (request.resource.data.authorUid == request.auth.uid || isAdmin()) &&
                       isValidSystemEvent(request.resource.data);

      // Atualização e Exclusão: estritamente proibidos para garantir integridade e não-repúdio do log
      allow update, delete: if false;
    }

    // ===============================================================
    // Bloqueio Padrão (Default Deny)
    // ===============================================================
    // Bloqueia qualquer leitura ou gravação em coleções ou rotas não mapeadas explicitamente
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
